rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ TROQUE pelo seu e-mail de dono do app (o mesmo do ADMIN_EMAIL no index.html)
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email == "markos_bad@hotmail.com";
    }
    function logado() { return request.auth != null; }

    // ---------- USUÁRIOS ----------
    // Cada um lê/escreve o próprio perfil, mas não pode se autoverificar de
    // "false" pra "true" — só o admin faz isso. Exceção: contas antigas sem o
    // campo "verificado" (nunca definido) são migradas automaticamente pro
    // app na primeira vez que logam, direto pra "true" (grandfather).
    match /users/{uid} {
      allow read: if logado() && (request.auth.uid == uid || isAdmin());
      allow create: if logado() && request.auth.uid == uid && request.resource.data.verificado == false;
      allow update: if logado() && (
        isAdmin()
        || (request.auth.uid == uid && (
              request.resource.data.get('verificado', null) == resource.data.get('verificado', null)
              || (resource.data.get('verificado', null) == null && request.resource.data.verificado == true)
            ))
      );
      allow delete: if false;
    }

    // ---------- ENTREGAS ----------
    match /entregas/{id} {
      // qualquer usuário logado vê as entregas (necessário p/ mapa em tempo real)
      allow read: if logado();

      // só a própria loja cria, já com status "disponivel", e só se não estiver suspensa
      allow create: if logado()
        && request.resource.data.lojaId == request.auth.uid
        && request.resource.data.status == "disponivel"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('suspenso', false) == false;

      // atualizações permitidas:
      // 1) a loja/solicitante dono (cancelar, avaliar entregador, relatar problema)
      // 2) o entregador designado (coletar, concluir, desistir, GPS, avaliar loja, relatar problema)
      // 3) um entregador aceitando uma entrega disponível (se designando) — só se
      //    ele não tiver nenhuma outra entrega ativa nem estiver suspenso (checado
      //    no próprio perfil dele) — nunca a própria entrega
      // 4) o admin, sempre (pra liberar entregas travadas, cancelar, resolver problemas)
      allow update: if logado() && (
        isAdmin()
        || resource.data.lojaId == request.auth.uid
        || resource.data.entregadorId == request.auth.uid
        || (resource.data.status == "disponivel"
            && request.resource.data.entregadorId == request.auth.uid
            && request.resource.data.entregadorId != resource.data.lojaId
            && request.resource.data.status == "aceita"
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('entregaAtivaId', null) == null
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('suspenso', false) == false)
      );

      allow delete: if false;
    }

    // ---------- SAQUES ----------
    match /saques/{id} {
      // entregador cria o próprio pedido de saque
      allow create: if logado()
        && request.resource.data.entregadorId == request.auth.uid
        && request.resource.data.status == "pendente";
      // entregador vê os próprios; admin vê e atualiza todos (marcar pago)
      allow read: if logado() && (resource.data.entregadorId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ---------- PRESENÇA (disponibilidade no mapa) ----------
    // Qualquer logado vê quem está disponível; cada um só escreve o próprio ponto.
    match /presenca/{uid} {
      allow read: if logado();
      allow write: if logado() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ---------- CÓDIGOS (código de coleta e PIN, separados da entrega) ----------
    // Só a loja dona e o entregador designado podem ler — ninguém mais vê o
    // código/PIN antes (ou depois) de aceitar a entrega.
    match /codigos/{id} {
      allow read: if logado() && (
        resource.data.lojaId == request.auth.uid
        || resource.data.entregadorId == request.auth.uid
      );
      // só a loja cria, e já sem entregador designado
      allow create: if logado()
        && request.resource.data.lojaId == request.auth.uid
        && request.resource.data.entregadorId == null;
      // atualização permitida: dono, entregador já designado, um entregador
      // se designando pela primeira vez (mesma condição do accept em /entregas),
      // ou o admin (pra liberar entregas travadas)
      allow update: if logado() && (
        isAdmin()
        || resource.data.lojaId == request.auth.uid
        || resource.data.entregadorId == request.auth.uid
        || (resource.data.entregadorId == null
            && request.resource.data.entregadorId == request.auth.uid)
      );
      allow delete: if false;
    }
  }
}
